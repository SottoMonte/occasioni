diff --git a/theme.css b/theme.css
new file mode 100644
index 0000000..93108a6
--- /dev/null
+++ b/theme.css
@@ -0,0 +1,72 @@
+/* Occasioni.online - tema 2: nebbia, inchiostro, cobalto, ambra. Caricato DOPO occasioni.css */
+:root{
+  --paper:#eaeff3;--ink:#101c2e;--forest:#14213d;--forest-deep:#0c1626;--white:#fff;
+  --acid:#ffb703;--coral:#2f4bff;--sky:#dbe4ff;--muted:#51607a;--line:#cdd7e2;
+  --display:"Bricolage Grotesque","Trebuchet MS",system-ui,sans-serif;
+  --body:"Instrument Sans",system-ui,sans-serif;--mono:var(--body);--ok:#1f9d6b;
+}
+body{font-size:16px;line-height:1.65}
+h1,h2,h3{font-family:var(--display);letter-spacing:-.02em}
+.topline{display:none}
+.eyebrow,.article-card__meta,.directory__filter-label,.program-card__type,.select-field,.market-listing__meta{
+  text-transform:none;letter-spacing:0;font-family:var(--body)}
+.eyebrow{font-size:14px;font-weight:600}
+
+/* header */
+.site-header{background:rgba(234,239,243,.93);backdrop-filter:blur(8px)}
+.brand__name{font-family:var(--display);font-size:21px;font-weight:800;letter-spacing:-.02em}
+.brand__name span{color:var(--coral);font-weight:800}
+.primary-nav{font-size:15px;font-weight:600}
+.primary-nav a{transition:box-shadow .15s}
+.primary-nav a:hover{box-shadow:inset 0 -3px var(--acid)}
+.header-link{padding:10px 18px;border-radius:999px;background:var(--ink);color:#fff;font-size:14px;font-weight:700;text-decoration:none}
+
+/* bottoni */
+.button{min-height:52px;padding:0 26px;border-radius:999px;font-size:15px;letter-spacing:0}
+.button--acid{background:var(--coral);color:#fff}
+.button--dark{background:var(--ink);color:#fff}
+
+/* hero: testo a sinistra, scheda controllo a destra */
+.hero{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:56px;align-items:center;
+  max-width:1240px;min-height:0;margin:0 auto;padding:76px 42px 84px;overflow:visible;background:transparent;color:var(--ink)}
+.hero::before,.hero::after,.hero__image,.hero__dot{display:none}
+.hero .hero__content{width:auto;max-width:none;margin:0;padding:0;animation:none}
+.hero .hero__content h1{color:var(--ink);font-size:clamp(2.7rem,5.6vw,4.7rem);font-weight:800;line-height:1.03}
+.hero .hero__content h1 em{font-style:normal;color:inherit;font-weight:inherit}
+.hero .hero__content .hero__intro{color:var(--muted);font-size:1.2rem;max-width:34rem;margin:24px 0 32px}
+.hero .hero__content .eyebrow{color:var(--coral)}
+.hero .hero__text-link{color:var(--ink);font-size:15px;font-weight:700}
+.hero__check{background:#fff;border:2px solid var(--ink);border-radius:20px;padding:28px;box-shadow:8px 8px 0 var(--acid)}
+.hero__check h2{font-size:1.4rem;margin:0 0 4px}
+.hero__check>p{margin:0 0 14px;color:var(--muted);font-size:15px}
+.hero__check ul{list-style:none;margin:0;padding:0}
+.hero__check li{display:flex;gap:14px;align-items:flex-start;padding:14px 0;border-top:1px solid var(--line);font-size:15px;color:var(--muted)}
+.hero__check li strong{display:block;font-family:var(--display);font-size:1.05rem;color:var(--ink)}
+.hero__tick{flex:none;width:26px;height:26px;border-radius:50%;background:var(--ok);display:grid;place-items:center;animation:tick-pop .35s both}
+.hero__tick::after{content:"";width:8px;height:14px;border:solid #fff;border-width:0 3px 3px 0;transform:translateY(-1px) rotate(45deg)}
+.hero__check li:nth-child(1) .hero__tick{animation-delay:.3s}.hero__check li:nth-child(2) .hero__tick{animation-delay:.55s}
+.hero__check li:nth-child(3) .hero__tick{animation-delay:.8s}.hero__check li:nth-child(4) .hero__tick{animation-delay:1.05s}
+@keyframes tick-pop{from{transform:scale(0)}to{transform:scale(1)}}
+
+/* aree della home: righe invece di card identiche */
+.home-areas__grid{display:block;border-top:2px solid var(--ink)}
+.home-area{display:grid;grid-template:"icon idx lnk" auto "icon ttl lnk" auto "icon txt lnk" auto/56px minmax(0,1fr) auto;
+  column-gap:24px;align-items:center;padding:28px 8px;background:transparent;border:0;border-bottom:1px solid var(--line);
+  border-radius:0;box-shadow:none;transform:none;transition:background .15s,padding .15s}
+.home-area:hover{background:#fff;padding-inline:20px}
+.home-area__icon{grid-area:icon}.home-area__index{grid-area:idx;font-size:13px;font-weight:600;color:var(--muted)}
+.home-area h3{grid-area:ttl;font-size:1.65rem;margin:0}.home-area p{grid-area:txt;margin:4px 0 0;color:var(--muted);max-width:42rem}
+.home-area__link{grid-area:lnk;padding:9px 18px;border-radius:999px;background:var(--coral);color:#fff;font-size:14px;font-weight:700;white-space:nowrap}
+.home-area:nth-child(n+3) .home-area__link{background:transparent;color:var(--ink);border:1.5px dashed var(--muted)}
+
+/* card dinamiche (guide, programmi, categorie) */
+.article-card,.program-card,.category-link{background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:none;transition:border-color .15s,transform .15s}
+.article-card:hover,.program-card:hover,.category-link:hover{border-color:var(--ink);transform:translateY(-2px)}
+.article-card__image{border-radius:10px}
+
+@media (max-width:900px){.hero{grid-template-columns:1fr;gap:40px;padding:44px 20px 60px}}
